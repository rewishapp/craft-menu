{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}
{% set title = isNew ? "New menu"|t('menu') : menu.title %}
{% set selectedSubnavItem = "menus" %}
{% set fullPageForm = true %}

{% block content %}
  {{ actionInput('menu/menus/save') }}
  {% if menu.id %}{{ hiddenInput('menuId', menu.id) }}{% endif %}

  {{ forms.lightswitchField({
    label: "Enabled"|t('app'),
    instructions: "Disabled menus render nothing on the front end and in GraphQL."|t('menu'),
    name: 'enabled',
    on: menu.enabled ?? true,
    first: true,
  }) }}

  {{ forms.textField({
    label: "Name"|t('app'),
    id: 'title',
    name: 'title',
    value: menu.title,
    required: true,
  }) }}

  {{ forms.textField({
    label: "Handle"|t('app'),
    id: 'handle',
    name: 'handle',
    value: menu.handle,
    required: true,
  }) }}

  {{ forms.textareaField({
    label: "Instructions"|t('app'),
    name: 'instructions',
    value: menu.instructions,
    rows: 3,
  }) }}

  {{ forms.textField({
    label: "CSS class"|t('menu'),
    instructions: "Extra classes for the menu wrapper (<nav>) when rendered with the nav macro."|t('menu'),
    id: 'cssClass',
    name: 'cssClass',
    value: menu.cssClass,
  }) }}

  {{ forms.textareaField({
    label: "HTML attributes"|t('menu'),
    instructions: 'JSON object or key="value" pairs for the menu wrapper, e.g. {"data-menu":"primary"}'|t('menu'),
    id: 'htmlAttributes',
    name: 'htmlAttributes',
    value: menu.htmlAttributes,
    rows: 2,
  }) }}

  {{ forms.textField({
    label: "Max levels"|t('menu'),
    instructions: "How deep nodes can nest."|t('menu'),
    name: 'maxLevels',
    value: menu.maxLevels,
    type: 'number',
    min: 1,
    max: 20,
  }) }}

  {% if sites|length > 1 %}
    <fieldset>
      <legend>{{ "Sites"|t('app') }}</legend>
      <p class="light">{{ "Choose which sites this menu is available on."|t('menu') }}</p>
      {% for site in sites %}
        {{ forms.checkboxField({
          label: site.name,
          name: 'siteIds[]',
          value: site.id,
          checked: site.id in enabledSiteIds,
        }) }}
      {% endfor %}
    </fieldset>
  {% else %}
    {% for site in sites %}
      {{ hiddenInput('siteIds[]', site.id) }}
    {% endfor %}
  {% endif %}

  <hr>
  {{ forms.fieldLayoutDesignerField({
    fieldLayout: nodeFieldLayout,
  }) }}
{% endblock %}
