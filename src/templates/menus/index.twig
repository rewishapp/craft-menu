{% extends "_layouts/cp" %}
{% set title = "Menus"|t('menu') %}
{% set selectedSubnavItem = "menus" %}
{% set actionButton %}
  {% if canCreate %}
    <a class="btn submit" href="{{ url('menu/new') }}">{{ "New menu"|t('menu') }}</a>
  {% endif %}
{% endset %}

{% block content %}
  {% if menus is empty %}
    <div class="pane" style="text-align: center; padding: 40px 20px;">
      <p style="margin: 0 0 6px; font-size: 15px; font-weight: 600;">{{ "No menus yet"|t('menu') }}</p>
      <p class="light" style="margin: 0;">{{ "Create one to start building navigation."|t('menu') }}</p>
      {% if canCreate %}
        <p style="margin-top: 16px;">
          <a class="btn submit" href="{{ url('menu/new') }}">{{ "New menu"|t('menu') }}</a>
        </p>
      {% endif %}
    </div>
  {% else %}
    <div class="pane">
      <table class="data fullwidth">
        <thead>
          <tr>
            <th>{{ "Name"|t('app') }}</th>
            <th>{{ "Handle"|t('app') }}</th>
            <th>{{ "Status"|t('app') }}</th>
            <th>{{ "Nodes"|t('menu') }}</th>
            <th>{{ "Links"|t('menu') }}</th>
            <th class="thin"></th>
          </tr>
        </thead>
        <tbody>
          {% for menu in menus %}
            <tr>
              <td>
                <a href="{{ url('menu/' ~ menu.id ~ '/nodes') }}"><strong>{{ menu.title }}</strong></a>
              </td>
              <td><code>{{ menu.handle }}</code></td>
              <td>
                <span class="status {{ menu.enabled ? 'enabled' : 'disabled' }}"></span>
                {{ menu.enabled ? "Enabled"|t('app') : "Disabled"|t('app') }}
              </td>
              <td>{{ nodeCounts[menu.id] ?? 0 }}</td>
              <td>
                {% set h = health[menu.id] ?? null %}
                {% if h and (h.broken or h.warning) %}
                  {% if h.broken %}<span class="menu-builder__flag menu-builder__flag--critical" title="{{ "Broken links"|t('menu') }}">{{ h.broken }} {{ "broken"|t('menu') }}</span>{% endif %}
                  {% if h.warning %}<span class="menu-builder__flag menu-builder__flag--warning" title="{{ "Links with warnings"|t('menu') }}">{{ h.warning }} {{ "warn"|t('menu') }}</span>{% endif %}
                {% else %}
                  <span class="light">{{ "OK"|t('menu') }}</span>
                {% endif %}
              </td>
              <td class="thin rightalign">
                <a class="btn small" href="{{ url('menu/' ~ menu.id) }}">{{ "Settings"|t('app') }}</a>
                <a class="btn small" href="{{ url('menu/' ~ menu.id ~ '/nodes') }}">{{ "Edit nodes"|t('menu') }}</a>
                <a class="btn small" href="{{ url('menu/' ~ menu.id ~ '/preview') }}">{{ "Preview"|t('menu') }}</a>
                {% if canCreate %}
                  <form method="post" style="display: inline;">
                    {{ csrfInput() }}
                    {{ actionInput('menu/menus/duplicate') }}
                    {{ hiddenInput('menuId', menu.id) }}
                    <button class="btn small" type="submit">{{ "Duplicate"|t('menu') }}</button>
                  </form>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}
{% endblock %}
