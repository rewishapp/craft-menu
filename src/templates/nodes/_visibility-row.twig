<div class="menu-vis__row" data-vis-row>
  <select class="menu-vis__type" name="meta[visibility][{{ index }}][type]" aria-label="{{ "Rule"|t('menu') }}" data-vis-type>
    {% for value, label in visibilityTypes %}
      <option value="{{ value }}"{% if row.type == value %} selected{% endif %}>{{ label }}</option>
    {% endfor %}
  </select>
  <input
    class="text fullwidth menu-vis__value"
    type="text"
    name="meta[visibility][{{ index }}][value]"
    value="{{ row.value }}"
    placeholder="{{ "Value"|t('menu') }}"
    aria-label="{{ "Value"|t('menu') }}"
    data-vis-value
  >
  <button type="button" class="menu-builder__icon-btn" data-vis-remove title="{{ "Remove rule"|t('menu') }}" aria-label="{{ "Remove rule"|t('menu') }}">
    <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M3.7 3.7a.75.75 0 0 1 1.06 0L8 6.94l3.24-3.24a.75.75 0 1 1 1.06 1.06L9.06 8l3.24 3.24a.75.75 0 1 1-1.06 1.06L8 9.06 4.76 12.3a.75.75 0 0 1-1.06-1.06L6.94 8 3.7 4.76a.75.75 0 0 1 0-1.06Z"/></svg>
  </button>
</div>
